use ProyectoBD2;

db.createCollection("bicicletas", {
    "capped": false,
    "validator": {
        "$jsonSchema": {
            "bsonType": "object",
            "title": "bicicletas",
            "properties": {
                "_id": {
                    "bsonType": "objectId"
                },
                "propietarioId": {
                    "bsonType": "objectId"
                },
                "marca": {
                    "bsonType": "string"
                },
                "modelo": {
                    "bsonType": "string"
                },
                "tipo": {
                    "bsonType": "string",
                    "enum": [
                        "urbana",
                        "ruta",
                        "montana",
                        "electrica"
                    ]
                },
                "color": {
                    "bsonType": "string"
                },
                "numeroSerie": {
                    "bsonType": "string"
                },
                "caracteristicas": {
                    "bsonType": "object",
                    "properties": {
                        "tamanoMarco": {
                            "bsonType": "string"
                        },
                        "material": {
                            "bsonType": "string"
                        },
                        "tamanoRueda": {
                            "bsonType": "string"
                        },
                        "tipoFrenos": {
                            "bsonType": "string"
                        },
                        "transmision": {
                            "bsonType": "string"
                        },
                        "suspension": {
                            "bsonType": "object",
                            "properties": {
                                "informacion": {
                                    "bsonType": "string"
                                },
                                "recorrido": {
                                    "bsonType": "int"
                                }
                            },
                            "additionalProperties": true,
                            "required": [
                                "informacion",
                                "recorrido"
                            ]
                        },
                        "bateria": {
                            "bsonType": "object",
                            "properties": {
                                "capacidadWh": {
                                    "bsonType": "double"
                                },
                                "voltajeV": {
                                    "bsonType": "double"
                                }
                            },
                            "additionalProperties": true,
                            "required": [
                                "capacidadWh",
                                "voltajeV"
                            ]
                        },
                        "motor": {
                            "bsonType": "object",
                            "properties": {
                                "tipo": {
                                    "bsonType": "string"
                                },
                                "potenciaW": {
                                    "bsonType": "int"
                                }
                            },
                            "additionalProperties": true,
                            "required": [
                                "tipo",
                                "potenciaW"
                            ]
                        }
                    },
                    "additionalProperties": true,
                    "required": [
                        "tamanoMarco",
                        "material",
                        "tamanoRueda",
                        "tipoFrenos"
                    ]
                }
            },
            "additionalProperties": true,
            "required": [
                "_id",
                "propietarioId",
                "marca",
                "modelo",
                "tipo",
                "color",
                "caracteristicas"
            ]
        }
    },
    "validationLevel": "moderate",
    "validationAction": "error"
});

db.bicicletas.createIndex({
    "_id": 1
},
{
    "name": "_id_"
});




